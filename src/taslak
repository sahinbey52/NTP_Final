
        try {
            grabber.start();
// Video yakalama döngüsü
            while (cek) {
                // Kareyi BufferedImage'ye dönüştürün
                Java2DFrameConverter converter = new Java2DFrameConverter();
                BufferedImage image = converter.convert(grabber.grab());

                // Görüntüyü JLabel'da gösterin
                img.setIcon(new ImageIcon(image));


                // Bekleme süresi (ms) - 30 FPS için 33 ms
                Thread.sleep(33);
            }
        } catch (Exception ex) {
            ex.printStackTrace();
        } finally {
            // Video yakalamayı durdurun ve kaynakları serbest bırakın
            try {
                grabber.stop();
                grabber.close();
            } catch (Exception ex) {
                ex.printStackTrace();
            }
        }